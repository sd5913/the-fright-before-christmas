# Copy to .env on the server; set a unique alphanumeric database password.
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password
# Used when running Node outside Docker; Compose supplies its own internal URL.
DATABASE_URL=postgresql://tfbc:replace-with-a-random-alphanumeric-password@127.0.0.1:5432/tfbc
PORT=3000
API_BASE_PATH=/tfbc-api
API_HOST_PORT=3107
CORS_ORIGINS=https://tfbc.darketomaly.com,https://metapool.cloud,http://localhost:4321,http://127.0.0.1:4321
# Use 1 only behind the included loopback-bound Nginx reverse proxy.
TRUST_PROXY=0
READ_RATE_LIMIT=300
WRITE_RATE_LIMIT=20
RATE_WINDOW_MS=60000

{
  "name": "tfbc-score-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "setup": "node scripts/setup-env.js",
    "test": "node --test test/unit.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/config.js && node --check src/store.js && node --check src/migrate.js && node --check src/validation.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "pg": "^8.23.1"
  }
}

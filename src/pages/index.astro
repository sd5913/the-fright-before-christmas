---
import '../styles/home.css';
import '../styles/home-motion.css';
const lights = [
  { x: 8, y: 24, color: 'warm' }, { x: 13, y: 29, color: 'pink' },
  { x: 19, y: 32, color: 'warm' }, { x: 24, y: 31, color: 'pink' },
  { x: 76, y: 31, color: 'warm' }, { x: 81, y: 32, color: 'pink' },
  { x: 87, y: 29, color: 'warm' }, { x: 92, y: 24, color: 'pink' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A spooky Christmas arcade adventure. Join Billy and Mandy and play The Fright Before Christmas in your browser." />
    <meta name="theme-color" content="#130f20" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/assets/home/room.webp" />
    <link rel="preload" as="image" href="/assets/home/logo.webp" />
    <title>The Fright Before Christmas — Play in your browser</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to game</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="The Fright Before Christmas home">TFBC<span aria-hidden="true">✦</span></a>
      <nav class="header-actions" aria-label="Main navigation">
        <a class="how-to-link" href="#how-to-play">How to play <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main-content">
      <section class="adventure" id="adventure" aria-label="The Fright Before Christmas" data-state="home" data-motion="off">
        <div class="hero-art" id="hero-art">
          <div class="room-layer" aria-hidden="true"></div>
          <div class="sky-layer" aria-hidden="true"><div class="nebula"></div><div class="star-field"></div></div>
          <canvas class="stardust" id="stardust" aria-hidden="true"></canvas>
          <div class="scene-shade" aria-hidden="true"></div>
          <div class="light-string" aria-hidden="true">
            {lights.map((light, index) => <span class={`fairy-light fairy-light--${light.color}`} style={`--x:${light.x}%;--y:${light.y}%;--delay:${index * -0.7}s`}></span>)}
          </div>
          <div class="ufo-parallax" aria-hidden="true"><img class="ufo" src="/assets/home/ufo.webp" width="800" height="533" alt="" draggable="false" /></div>
          <div class="floor-glow" aria-hidden="true"></div>
          <div class="character character--billy" aria-hidden="true"><div class="character-shadow"></div><img src="/assets/home/characters/billy-poster-v7.webp" data-poster-src="/assets/home/characters/billy-poster-v7.webp" data-idle-src="/assets/home/characters/billy-idle-v7.gif" data-character-state="paused" width="420" height="498" alt="" draggable="false" /></div>
          <div class="character character--mandy" aria-hidden="true"><div class="character-shadow"></div><img src="/assets/home/characters/mandy-poster.webp" data-poster-src="/assets/home/characters/mandy-poster.webp" data-idle-src="/assets/home/characters/mandy-idle.gif" data-character-state="paused" width="420" height="508" alt="" draggable="false" /></div>

          <div class="hero-content">
            <p class="eyebrow"><span aria-hidden="true">✦</span> A little spooky. A little festive.</p>
            <h1 class="game-title">
              <img id="game-logo" src="/assets/home/logo.webp" width="1100" height="733" alt="The Fright Before Christmas" fetchpriority="high" />
              <span class="logo-fallback" hidden>The Fright<br />Before Christmas</span>
            </h1>
            <p class="hero-tagline">Your Christmas just got a little stranger.</p>
            <button class="play-button" id="play-button" type="button" disabled><span id="play-label">Play now</span><svg viewBox="0 0 24 24" width="25" height="25" fill="currentColor" aria-hidden="true"><path d="M7 3.5v17L21 12z" /></svg></button>
            <noscript><p class="no-script">JavaScript is needed to start the game. Please enable it, then reload this page.</p></noscript>
          </div>
          <div class="scene-caption" aria-hidden="true"><span class="caption-line"></span><span>A spooky Christmas arcade adventure</span><span class="caption-line"></span></div>
        </div>
        <section class="game-panel" id="game-panel" aria-label="Game player" hidden>
          <div class="game-toolbar"><button class="text-button" id="back-button" type="button"><span aria-hidden="true">←</span> Back to homepage</button><span class="game-toolbar-label">The Fright Before Christmas</span></div>
          <div class="game-viewport" id="game-viewport" aria-busy="false">
            <div class="game-mount" id="game-mount"></div>
            <div class="entry-loading" id="entry-loading" hidden><span class="loading-star" aria-hidden="true">✦</span><p>Opening your adventure…</p><span>Preparing the game window</span></div>
          </div>
          <div class="game-message" id="game-message" role="status" aria-live="polite"><span id="game-status"></span><button class="text-button" id="retry-button" type="button" hidden>Try again <span aria-hidden="true">↻</span></button></div>
        </section>
      </section>

      <section class="field-notes" id="how-to-play" aria-labelledby="how-to-title">
        <div class="field-notes-heading"><span class="eyebrow">Before the adventure</span><h2 id="how-to-title">Make yourself at home.<br />Keep your eyes on the sky.</h2></div>
        <div class="control-notes">
          <div class="control-note"><span class="keycap" aria-hidden="true">↖</span><div><h3>Mouse to aim</h3><p>Move your mouse to aim your character’s blaster.</p></div></div>
          <div class="control-note"><span class="keycap keycap--space" aria-hidden="true">SPACE</span><div><h3>Switch characters</h3><p>Press the space bar to swap characters.</p></div></div>
          <p class="desktop-note">Best played on desktop with a mouse and keyboard.</p>
        </div>
      </section>
    </main>
    <footer class="site-footer"><span>THE FRIGHT BEFORE CHRISTMAS</span><span>A little holiday mischief, right in your browser.</span><a href="#main-content">Back to top <span aria-hidden="true">↑</span></a></footer>
    <script>
      import '../scripts/home';
    </script>
  </body>
</html>
